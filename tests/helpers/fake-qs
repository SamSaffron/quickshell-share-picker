#!/bin/sh

set -eu

# Deliberately noisy: the real wrapper must prevent all qs output from reaching
# its stdout selection channel.
printf 'fake qs stdout noise\n'
printf 'fake qs stderr noise\n' >&2

case ${QSP_FAKE_MODE:-success} in
    success)
        printf '%s\n' "${QSP_FAKE_SELECTION:-[SELECTION]/window:17}" >"$QSP_RESULT_FILE"
        ;;
    allow-token)
        if [ "${QSP_ALLOW_TOKEN:-0}" = 1 ]; then
            printf '%s\n' '[SELECTION]r/window:17' >"$QSP_RESULT_FILE"
        else
            printf '%s\n' '[SELECTION]/window:17' >"$QSP_RESULT_FILE"
        fi
        ;;
    token-visibility)
        if [ "${QSP_ALLOW_TOKEN_SELECTION:-0}" = 1 ]; then
            printf '%s\n' '[SELECTION]r/window:18' >"$QSP_RESULT_FILE"
        else
            printf '%s\n' '[SELECTION]r/window:17' >"$QSP_RESULT_FILE"
        fi
        ;;
    live-test)
        if [ "${QSP_LIVE_TEST_MODE:-0}" != 1 ] || [ "${QSP_TEST_MODE:-0}" != 0 ]; then
            exit 65
        fi
        if ! grep -F '"windows":[]' "$QSP_SESSION_FILE" >/dev/null; then
            exit 66
        fi
        printf '%s\n' '[SELECTION]/window:1' >"$QSP_RESULT_FILE"
        ;;
    region-request)
        if [ "${QSP_REGION_RECOVERY:-0}" != 1 ]; then
            printf '%s\n' '{"allowRestore":true,"screens":[{"height":1440,"name":"DP-1","width":2560,"x":0,"y":0}]}' >"$QSP_REGION_REQUEST_FILE"
        fi
        ;;
    region-recovery)
        if [ "${QSP_REGION_RECOVERY:-0}" = 1 ]; then
            printf '%s\n' '[SELECTION]/window:17' >"$QSP_RESULT_FILE"
        else
            printf '%s\n' '{"allowRestore":true,"screens":[{"height":1440,"name":"DP-1","width":2560,"x":0,"y":0}]}' >"$QSP_REGION_REQUEST_FILE"
        fi
        ;;
    region-recovery-token | region-recovery-checked)
        if [ "${QSP_REGION_RECOVERY:-0}" = 1 ]; then
            if [ "${QSP_ALLOW_TOKEN:-0}" = 0 ]; then
                printf '%s\n' '[SELECTION]/window:17' >"$QSP_RESULT_FILE"
            else
                printf '%s\n' '[SELECTION]r/window:17' >"$QSP_RESULT_FILE"
            fi
        else
            allow_restore=false
            if [ "${QSP_FAKE_MODE:-}" = region-recovery-checked ]; then
                allow_restore=true
            fi
            printf '{"allowRestore":%s,"screens":[{"height":1440,"name":"DP-1","width":2560,"x":0,"y":0}]}\n' "$allow_restore" >"$QSP_REGION_REQUEST_FILE"
        fi
        ;;
    repeat-region)
        "$QSP_PYTHON_BIN" - "$QSP_SESSION_FILE" "$QSP_REPEAT_REGION_REQUEST_FILE" <<'PY'
import json
import sys

session = json.load(open(sys.argv[1], encoding="utf-8"))
request = {
    "allowRestore": False,
    "region": session["lastRegion"],
    "screens": [{"height": 1440, "name": "DP-1", "width": 2560, "x": 0, "y": 0}],
}
with open(sys.argv[2], "w", encoding="utf-8") as stream:
    json.dump(request, stream)
    stream.write("\n")
PY
        ;;
    conflicting-actions)
        printf '%s\n' '[SELECTION]/window:17' >"$QSP_RESULT_FILE"
        printf '%s\n' '{"allowRestore":true,"screens":[]}' >"$QSP_REGION_REQUEST_FILE"
        ;;
    cancel)
        ;;
    malformed)
        printf '%s\n' 'diagnostic that is not protocol' >"$QSP_RESULT_FILE"
        ;;
    wait)
        sleep 30
        ;;
    failure)
        exit 42
        ;;
    *)
        exit 64
        ;;
esac
